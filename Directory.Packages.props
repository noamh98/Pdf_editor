<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <!-- UI -->
    <PackageVersion Include="Avalonia" Version="11.3.7" />
    <PackageVersion Include="Avalonia.Desktop" Version="11.3.7" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="11.3.7" />
    <PackageVersion Include="Avalonia.Diagnostics" Version="11.3.7" />
    <PackageVersion Include="Avalonia.Headless" Version="11.3.7" />
    <PackageVersion Include="Avalonia.Headless.XUnit" Version="11.3.7" />
    <PackageVersion Include="Avalonia.Controls.ItemsRepeater" Version="11.1.5" />
    <!-- Avalonia.Desktop pulls this in transitively for Linux D-Bus integration (tray icons,
         notifications) via Avalonia.FreeDesktop; it is never touched on the Windows target this
         application ships for. 0.21.2 carries a High severity advisory (GHSA-xrw6-gwf8-vvr9); pinned
         here to force the whole graph onto a patched release. -->
    <PackageVersion Include="Tmds.DBus.Protocol" Version="0.21.3" />
    <!-- PDF -->
    <PackageVersion Include="PdfSharp" Version="6.2.4" />
    <!-- Pinned to the 4.x line: it builds against SkiaSharp 2.88, which is what Avalonia 11.3
         also uses. PDFtoImage 5.x requires SkiaSharp 3.x/4.x, and loading both in one process makes
         the native libSkiaSharp version mismatch and rendering fail at runtime. -->
    <PackageVersion Include="PDFtoImage" Version="4.1.1" />
    <PackageVersion Include="SkiaSharp" Version="2.88.9" />
    <!-- OCR -->
    <PackageVersion Include="Tesseract" Version="5.2.0" />
    <!-- Windows platform integration -->
    <PackageVersion Include="System.Drawing.Common" Version="8.0.10" />
    <PackageVersion Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <!-- Tests -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageVersion Include="xunit" Version="2.9.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageVersion Include="coverlet.collector" Version="6.0.2" />
  </ItemGroup>
</Project>
