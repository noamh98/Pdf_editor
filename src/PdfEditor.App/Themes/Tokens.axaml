<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    Design tokens. Every colour in the application comes from here; no view declares a literal.
    Contrast ratios below were computed against the WCAG 2.1 formula and are stated as measured.

    The brushes live inside the theme dictionaries rather than being derived from colour keys
    outside them: a SolidColorBrush declared at dictionary level has no place in the logical tree,
    so a DynamicResource on its Color does not follow a theme variant change and the palette
    stays frozen on whichever variant loaded first.
 -->
  <ResourceDictionary.ThemeDictionaries>

    <ResourceDictionary x:Key="Light">
      <!-- Surfaces -->
      <Color x:Key="CanvasColor">#F4F6F9</Color>
      <Color x:Key="PanelColor">#FFFFFF</Color>
      <Color x:Key="PanelAltColor">#EDF1F6</Color>
      <Color x:Key="BorderColor">#D8DEE7</Color>
      <Color x:Key="BorderStrongColor">#B7C1CE</Color>

      <!-- Text: 15.28:1 on canvas, 16.55:1 on panel -->
      <Color x:Key="TextColor">#1A1F27</Color>
      <!-- Secondary text: 5.56:1 on canvas -->
      <Color x:Key="TextMutedColor">#5A6470</Color>
      <Color x:Key="TextOnAccentColor">#FFFFFF</Color>

      <!-- Accent: 8.31:1 against panel, and white on it is also 8.31:1 -->
      <Color x:Key="AccentColor">#1F4E8C</Color>
      <Color x:Key="AccentHoverColor">#2A63AC</Color>
      <Color x:Key="AccentSoftColor">#E4EDF9</Color>
      <Color x:Key="FocusColor">#1F4E8C</Color>

      <!-- Status: 7.54:1 for danger on panel -->
      <Color x:Key="DangerColor">#A32020</Color>
      <Color x:Key="SuccessColor">#1D6B3A</Color>
      <Color x:Key="WarningColor">#8A5A00</Color>

      <SolidColorBrush x:Key="CanvasBrush" Color="#F4F6F9" />
      <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="PanelAltBrush" Color="#EDF1F6" />
      <SolidColorBrush x:Key="PanelSunkenBrush" Color="#E7ECF3" />
      <SolidColorBrush x:Key="BorderBrush" Color="#D8DEE7" />
      <SolidColorBrush x:Key="BorderStrongBrush" Color="#B7C1CE" />
      <SolidColorBrush x:Key="TextBrush" Color="#1A1F27" />
      <SolidColorBrush x:Key="TextMutedBrush" Color="#5A6470" />
      <SolidColorBrush x:Key="TextOnAccentBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="AccentBrush" Color="#1F4E8C" />
      <SolidColorBrush x:Key="AccentHoverBrush" Color="#2A63AC" />
      <SolidColorBrush x:Key="AccentSoftBrush" Color="#E4EDF9" />
      <SolidColorBrush x:Key="FocusBrush" Color="#1F4E8C" />
      <SolidColorBrush x:Key="DangerBrush" Color="#A32020" />
      <SolidColorBrush x:Key="DangerSoftBrush" Color="#FBE9E9" />
      <SolidColorBrush x:Key="SuccessBrush" Color="#1D6B3A" />
      <SolidColorBrush x:Key="WarningBrush" Color="#8A5A00" />
      <SolidColorBrush x:Key="SelectionBrush" Color="#3D1F4E8C" />
      <SolidColorBrush x:Key="HoverBrush" Color="#141F4E8C" />
      <SolidColorBrush x:Key="PressedBrush" Color="#291F4E8C" />
      <SolidColorBrush x:Key="ScrimBrush" Color="#59101725" />

      <!-- The document board sits behind the pages and is intentionally darker than the chrome. -->
      <SolidColorBrush x:Key="BoardBrush" Color="#E2E7EE" />
      <BoxShadows x:Key="PageShadow">0 2 6 0 #1F000000, 0 12 28 -6 #33000000</BoxShadows>
      <BoxShadows x:Key="CardShadow">0 10 30 -8 #33101725</BoxShadows>
      <BoxShadows x:Key="BarShadow">0 1 3 0 #14101725</BoxShadows>

      <!-- A floating side panel is lit from no particular direction: the same template is hosted on
           the leading and the trailing edge, so an offset shadow would fall inwards on one of them.-->
      <BoxShadows x:Key="PanelShadow">0 0 26 0 #38101725</BoxShadows>
    </ResourceDictionary>

    <ResourceDictionary x:Key="Dark">
      <Color x:Key="CanvasColor">#14181F</Color>
      <Color x:Key="PanelColor">#1B2029</Color>
      <Color x:Key="PanelAltColor">#232A35</Color>
      <Color x:Key="BorderColor">#2C3542</Color>
      <Color x:Key="BorderStrongColor">#3E4A5A</Color>

      <!-- Text: 15.02:1 on canvas, 13.79:1 on panel -->
      <Color x:Key="TextColor">#E8ECF3</Color>
      <!-- Secondary text: 7.21:1 on canvas -->
      <Color x:Key="TextMutedColor">#9AA6B6</Color>
      <Color x:Key="TextOnAccentColor">#0B1017</Color>

      <!-- Accent: 7.56:1 against panel; the dark text on it is 8.83:1 -->
      <Color x:Key="AccentColor">#7FB2FF</Color>
      <Color x:Key="AccentHoverColor">#9CC4FF</Color>
      <Color x:Key="AccentSoftColor">#1E2C3F</Color>
      <Color x:Key="FocusColor">#7FB2FF</Color>

      <!-- Status: 7.16:1 for danger on panel -->
      <Color x:Key="DangerColor">#FF8A80</Color>
      <Color x:Key="SuccessColor">#6FD08C</Color>
      <Color x:Key="WarningColor">#F0C05A</Color>

      <SolidColorBrush x:Key="CanvasBrush" Color="#14181F" />
      <SolidColorBrush x:Key="PanelBrush" Color="#1B2029" />
      <SolidColorBrush x:Key="PanelAltBrush" Color="#232A35" />
      <SolidColorBrush x:Key="PanelSunkenBrush" Color="#11151B" />
      <SolidColorBrush x:Key="BorderBrush" Color="#2C3542" />
      <SolidColorBrush x:Key="BorderStrongBrush" Color="#3E4A5A" />
      <SolidColorBrush x:Key="TextBrush" Color="#E8ECF3" />
      <SolidColorBrush x:Key="TextMutedBrush" Color="#9AA6B6" />
      <SolidColorBrush x:Key="TextOnAccentBrush" Color="#0B1017" />
      <SolidColorBrush x:Key="AccentBrush" Color="#7FB2FF" />
      <SolidColorBrush x:Key="AccentHoverBrush" Color="#9CC4FF" />
      <SolidColorBrush x:Key="AccentSoftBrush" Color="#1E2C3F" />
      <SolidColorBrush x:Key="FocusBrush" Color="#7FB2FF" />
      <SolidColorBrush x:Key="DangerBrush" Color="#FF8A80" />
      <SolidColorBrush x:Key="DangerSoftBrush" Color="#33201F" />
      <SolidColorBrush x:Key="SuccessBrush" Color="#6FD08C" />
      <SolidColorBrush x:Key="WarningBrush" Color="#F0C05A" />
      <SolidColorBrush x:Key="SelectionBrush" Color="#4D7FB2FF" />
      <SolidColorBrush x:Key="HoverBrush" Color="#1F7FB2FF" />
      <SolidColorBrush x:Key="PressedBrush" Color="#337FB2FF" />
      <SolidColorBrush x:Key="ScrimBrush" Color="#8C000000" />

      <SolidColorBrush x:Key="BoardBrush" Color="#0E1116" />
      <BoxShadows x:Key="PageShadow">0 2 6 0 #59000000, 0 14 32 -6 #73000000</BoxShadows>
      <BoxShadows x:Key="CardShadow">0 12 34 -8 #8C000000</BoxShadows>
      <BoxShadows x:Key="BarShadow">0 1 3 0 #4D000000</BoxShadows>
      <BoxShadows x:Key="PanelShadow">0 0 30 0 #A6000000</BoxShadows>
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>

  <!--
    Ink laid over the page. These sit outside the theme dictionaries on purpose: the page is white
    paper in both themes, so chrome colours chosen against a dark panel are the wrong ones here.
    The dark palette's accent measures 2.16:1 against paper; these are 8.31:1 and 3.78:1.
  -->
  <Color x:Key="PageAccentColor">#1F4E8C</Color>
  <Color x:Key="PageGuideColor">#7A8494</Color>

  <!-- Spacing scale, in device-independent pixels -->
  <x:Double x:Key="Space1">4</x:Double>
  <x:Double x:Key="Space2">8</x:Double>
  <x:Double x:Key="Space3">12</x:Double>
  <x:Double x:Key="Space4">16</x:Double>
  <x:Double x:Key="Space5">24</x:Double>
  <x:Double x:Key="Space6">32</x:Double>

  <Thickness x:Key="PanelPadding">12</Thickness>
  <Thickness x:Key="DialogPadding">20</Thickness>

  <!-- Radii -->
  <CornerRadius x:Key="RadiusSmall">6</CornerRadius>
  <CornerRadius x:Key="RadiusMedium">10</CornerRadius>
  <CornerRadius x:Key="RadiusLarge">14</CornerRadius>
  <CornerRadius x:Key="RadiusPill">999</CornerRadius>

  <!-- Typography. The stack keeps Hebrew readable even where the first choice is absent. -->
  <FontFamily x:Key="UiFontFamily">Segoe UI,Noto Sans Hebrew,Arial,DejaVu Sans,sans-serif</FontFamily>
  <x:Double x:Key="FontSizeSmall">12</x:Double>
  <x:Double x:Key="FontSizeBody">13.5</x:Double>
  <x:Double x:Key="FontSizeLarge">16</x:Double>
  <x:Double x:Key="FontSizeTitle">20</x:Double>
  <x:Double x:Key="FontSizeDisplay">28</x:Double>

  <!-- Hit target floor, from the accessibility requirements -->
  <x:Double x:Key="HitTargetMin">32</x:Double>
</ResourceDictionary>
