<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PdfEditor.App.ViewModels"
        xmlns:ctl="clr-namespace:PdfEditor.App.Controls"
        xmlns:loc="clr-namespace:PdfEditor.Core.Localization;assembly=PdfEditor.Core"
        x:Class="PdfEditor.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        FlowDirection="RightToLeft"
        Title="{Binding WindowTitle}"
        Width="1280" Height="820"
        MinWidth="900" MinHeight="600"
        Icon="avares://PdfEditor/Assets/app.ico"
        Background="{DynamicResource CanvasBrush}">

  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+O" Command="{Binding OpenCommand}" />
    <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+S" Command="{Binding SaveAsCommand}" />
    <KeyBinding Gesture="Ctrl+P" Command="{Binding PrintCommand}" />
    <KeyBinding Gesture="Ctrl+Z" Command="{Binding UndoCommand}" />
    <KeyBinding Gesture="Ctrl+Y" Command="{Binding RedoCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+Z" Command="{Binding RedoCommand}" />
    <KeyBinding Gesture="Ctrl+C" Command="{Binding CopySelectionCommand}" />
    <KeyBinding Gesture="Ctrl+V" Command="{Binding PasteCommand}" />
    <KeyBinding Gesture="Ctrl+D" Command="{Binding DuplicateSelectionCommand}" />
    <KeyBinding Gesture="Delete" Command="{Binding DeleteSelectionCommand}" />
    <KeyBinding Gesture="Escape" Command="{Binding ClearSelectionCommand}" />
    <KeyBinding Gesture="Ctrl+OemPlus" Command="{Binding ZoomInCommand}" />
    <KeyBinding Gesture="Ctrl+Add" Command="{Binding ZoomInCommand}" />
    <KeyBinding Gesture="Ctrl+OemMinus" Command="{Binding ZoomOutCommand}" />
    <KeyBinding Gesture="Ctrl+Subtract" Command="{Binding ZoomOutCommand}" />
    <KeyBinding Gesture="Ctrl+D0" Command="{Binding FitPageCommand}" />
    <KeyBinding Gesture="Ctrl+NumPad0" Command="{Binding FitPageCommand}" />
    <KeyBinding Gesture="PageDown" Command="{Binding NextPageCommand}" />
    <KeyBinding Gesture="PageUp" Command="{Binding PreviousPageCommand}" />
  </Window.KeyBindings>

  <Grid RowDefinitions="Auto,Auto,*,Auto">

    <!-- Command bar -->
    <Border Grid.Row="0" Classes="bar" BorderThickness="0,0,0,1" Padding="10,6">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="2">
          <Button Classes="command" Command="{Binding OpenCommand}"
                  ToolTip.Tip="{x:Static loc:Strings.Open}"
                  AutomationProperties.Name="{x:Static loc:Strings.Open}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Path Data="{x:Static vm:Icons.Open}" Fill="{Binding $parent[Button].Foreground}" />
              <TextBlock Text="{x:Static loc:Strings.Open}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>

          <Rectangle Width="1" Margin="6,4" Fill="{DynamicResource BorderBrush}" />

          <Button Classes="command" Command="{Binding SaveCommand}"
                  ToolTip.Tip="Ctrl+S" AutomationProperties.Name="{x:Static loc:Strings.Save}">
            <Path Data="{x:Static vm:Icons.Save}" Fill="{Binding $parent[Button].Foreground}" />
          </Button>
          <Button Classes="command" Command="{Binding SaveAsCommand}"
                  ToolTip.Tip="{x:Static loc:Strings.SaveAs}"
                  AutomationProperties.Name="{x:Static loc:Strings.SaveAs}">
            <Path Data="{x:Static vm:Icons.SaveAs}" Fill="{Binding $parent[Button].Foreground}" />
          </Button>
          <Button Classes="command" Command="{Binding ExportCommand}"
                  ToolTip.Tip="{x:Static loc:Strings.ExportFinalCopy}"
                  AutomationProperties.Name="{x:Static loc:Strings.ExportFinalCopy}">
            <Path Data="{x:Static vm:Icons.Export}" Fill="{Binding $parent[Button].Foreground}" />
          </Button>
          <Button Classes="command" Command="{Binding PrintCommand}"
                  ToolTip.Tip="Ctrl+P" AutomationProperties.Name="{x:Static loc:Strings.Print}">
            <Path Data="{x:Static vm:Icons.Print}" Fill="{Binding $parent[Button].Foreground}" />
          </Button>

          <Rectangle Width="1" Margin="6,4" Fill="{DynamicResource BorderBrush}" />

          <Button Classes="command" Command="{Binding UndoCommand}"
                  ToolTip.Tip="{x:Static loc:Strings.Undo}"
                  AutomationProperties.Name="{x:Static loc:Strings.Undo}">
            <Path Data="{x:Static vm:Icons.Undo}" Fill="{Binding $parent[Button].Foreground}" />
          </Button>
          <Button Classes="command" Command="{Binding RedoCommand}"
                  ToolTip.Tip="{x:Static loc:Strings.Redo}"
                  AutomationProperties.Name="{x:Static loc:Strings.Redo}">
            <Path Data="{x:Static vm:Icons.Redo}" Fill="{Binding $parent[Button].Foreground}" />
          </Button>

          <Rectangle Width="1" Margin="6,4" Fill="{DynamicResource BorderBrush}" />

          <Button Classes="command" Command="{Binding MergeCommand}"
                  ToolTip.Tip="{x:Static loc:Strings.Merge}"
                  AutomationProperties.Name="{x:Static loc:Strings.Merge}">
            <Path Data="{x:Static vm:Icons.Merge}" Fill="{Binding $parent[Button].Foreground}" />
          </Button>
          <Button Classes="command" Command="{Binding SplitCommand}"
                  ToolTip.Tip="{x:Static loc:Strings.Split}"
                  AutomationProperties.Name="{x:Static loc:Strings.Split}">
            <Path Data="{x:Static vm:Icons.Split}" Fill="{Binding $parent[Button].Foreground}" />
          </Button>
          <Button Classes="command" Command="{Binding RunOcrCommand}"
                  ToolTip.Tip="{x:Static loc:Strings.OcrRunOnPage}"
                  AutomationProperties.Name="{x:Static loc:Strings.Ocr}">
            <Path Data="{x:Static vm:Icons.Ocr}" Fill="{Binding $parent[Button].Foreground}" />
          </Button>
        </StackPanel>

        <TextBox Grid.Column="1" Name="SearchBox" MaxWidth="360" Margin="16,0"
                 Watermark="{x:Static loc:Strings.Search}"
                 Text="{Binding SearchText, Mode=TwoWay}"
                 AutomationProperties.Name="{x:Static loc:Strings.Search}" />

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2">
          <Button Classes="command" Command="{Binding ZoomOutCommand}"
                  AutomationProperties.Name="{x:Static loc:Strings.ZoomOut}"
                  ToolTip.Tip="{x:Static loc:Strings.ZoomOut}">
            <Path Data="{x:Static vm:Icons.ZoomOut}" Fill="{Binding $parent[Button].Foreground}" />
          </Button>
          <TextBlock Text="{Binding Document.ZoomPercentText}" VerticalAlignment="Center"
                     MinWidth="52" TextAlignment="Center" />
          <Button Classes="command" Command="{Binding ZoomInCommand}"
                  AutomationProperties.Name="{x:Static loc:Strings.ZoomIn}"
                  ToolTip.Tip="{x:Static loc:Strings.ZoomIn}">
            <Path Data="{x:Static vm:Icons.ZoomIn}" Fill="{Binding $parent[Button].Foreground}" />
          </Button>
          <Button Classes="command" Command="{Binding FitWidthCommand}"
                  AutomationProperties.Name="{x:Static loc:Strings.FitWidth}"
                  ToolTip.Tip="{x:Static loc:Strings.FitWidth}">
            <Path Data="{x:Static vm:Icons.FitWidth}" Fill="{Binding $parent[Button].Foreground}" />
          </Button>
          <Button Classes="command" Command="{Binding FitPageCommand}"
                  AutomationProperties.Name="{x:Static loc:Strings.FitPage}"
                  ToolTip.Tip="{x:Static loc:Strings.FitPage}">
            <Path Data="{x:Static vm:Icons.FitPage}" Fill="{Binding $parent[Button].Foreground}" />
          </Button>

          <Rectangle Width="1" Margin="6,4" Fill="{DynamicResource BorderBrush}" />

          <Button Classes="command" Command="{Binding ToggleThemeCommand}"
                  Content="{Binding ThemeLabel}"
                  AutomationProperties.Name="{x:Static loc:Strings.ThemeLabel}"
                  ToolTip.Tip="{x:Static loc:Strings.ThemeLabel}" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Tool strip -->
    <Border Grid.Row="1" Classes="bar" BorderThickness="0,0,0,1" Padding="10,4"
            IsVisible="{Binding HasDocument}"
            AutomationProperties.Name="{x:Static loc:Strings.A11yToolbar}">
      <ItemsControl ItemsSource="{Binding Toolbox.Tools}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal" Spacing="2" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:ToolItemViewModel">
            <ToggleButton Classes="tool"
                          IsChecked="{Binding IsSelected, Mode=OneWay}"
                          Click="OnToolClicked"
                          Tag="{Binding Tool}"
                          ToolTip.Tip="{Binding AccessibleName}"
                          AutomationProperties.Name="{Binding AccessibleName}">
              <Path Data="{Binding Glyph}" Fill="{Binding $parent[ToggleButton].Foreground}" />
            </ToggleButton>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Border>

    <!-- Main area: thumbnails on the right (the leading side under RTL), properties on the left -->
    <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto">

      <Border Grid.Column="0" Name="ThumbnailsPanel" Classes="bar" BorderThickness="0,0,1,0" Width="190"
              IsVisible="{Binding HasDocument}"
              AutomationProperties.Name="{x:Static loc:Strings.A11yThumbnailList}">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Classes="sectionHeader" Margin="10,10,10,4"
                     Text="{x:Static loc:Strings.Thumbnails}" />
          <ListBox Name="ThumbnailList" Background="Transparent" BorderThickness="0"
                   ItemsSource="{Binding Document.Pages}"
                   SelectedIndex="{Binding Document.CurrentPageIndex, Mode=TwoWay}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:PageViewModel">
                <StackPanel Spacing="4" Margin="2,4">
                  <Border Classes="thumb" Classes.current="{Binding IsSelected}"
                          Width="120" HorizontalAlignment="Center">
                    <Image Source="{Binding Thumbnail}" Stretch="Uniform" Height="150" />
                  </Border>
                  <TextBlock Text="{Binding PageNumber}" HorizontalAlignment="Center"
                             Classes="muted" FontWeight="{Binding IsSelected, Converter={StaticResource BoolToWeight}}" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

      <!-- Document canvas -->
      <Panel Grid.Column="1" Name="DocumentArea">
        <ScrollViewer Name="DocumentScroll" Padding="24"
                      HorizontalScrollBarVisibility="Auto"
                      AutomationProperties.Name="{x:Static loc:Strings.A11yPageCanvas}"
                      IsVisible="{Binding HasDocument}">
          <ItemsControl ItemsSource="{Binding Document.Pages}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <VirtualizingStackPanel Orientation="Vertical" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:PageViewModel">
                <Border Classes="page" HorizontalAlignment="Center"
                        Width="{Binding DisplayWidth}" Height="{Binding DisplayHeight}">
                  <ctl:PageSurface Page="{Binding}"
                                   Document="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Document}"
                                   ActiveTool="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Toolbox.ActiveTool}" />
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

        <!-- Empty state -->
        <Border IsVisible="{Binding IsEmpty}" Padding="40">
          <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="14" MaxWidth="460">
            <Image Source="avares://PdfEditor/Assets/app-256.png" Width="96" Height="96"
                   HorizontalAlignment="Center" />
            <TextBlock Classes="display" Text="{x:Static loc:Strings.AppName}"
                       HorizontalAlignment="Center" />
            <TextBlock Classes="muted" Text="{x:Static loc:Strings.AppTagline}"
                       HorizontalAlignment="Center" TextAlignment="Center" />
            <TextBlock Text="{x:Static loc:Strings.EmptyStateBody}" TextAlignment="Center"
                       HorizontalAlignment="Center" Margin="0,8,0,0" />
            <Button Classes="primary" Command="{Binding OpenCommand}"
                    Content="{x:Static loc:Strings.OpenFile}" HorizontalAlignment="Center" />
            <TextBlock Classes="muted" Text="{x:Static loc:Strings.PrivacyBody}"
                       TextAlignment="Center" Margin="0,16,0,0" />
          </StackPanel>
        </Border>
      </Panel>

      <!-- Properties panel -->
      <Border Grid.Column="2" Name="PropertiesPanel" Classes="bar" BorderThickness="1,0,0,0" Width="250"
              IsVisible="{Binding Properties.HasTarget, FallbackValue=False}"
              AutomationProperties.Name="{x:Static loc:Strings.A11yPropertiesPanel}">
        <ScrollViewer Padding="12">
          <StackPanel Spacing="12" DataContext="{Binding Properties}"
                      x:DataType="vm:PropertiesViewModel">
            <TextBlock Classes="title" Text="{Binding TitleText}" />
            <TextBlock Classes="muted" Text="{Binding PageText}" />

            <TextBlock IsVisible="{Binding IsForeign}" Classes="muted"
                       Text="הערה זו נוצרה בתוכנה אחרת ולכן אינה ניתנת לעריכה כאן. היא תישמר כפי שהיא." />

            <StackPanel Spacing="8" IsVisible="{Binding IsEditable}">
              <TextBlock Classes="sectionHeader" Text="צבע" />
              <ItemsControl ItemsSource="{x:Static vm:PropertiesViewModel.Swatches}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ColorSwatch">
                    <Button Width="32" Height="32" Margin="0,0,6,6" Padding="0"
                            Click="OnSwatchClicked" Tag="{Binding}"
                            AutomationProperties.Name="{Binding Name}"
                            ToolTip.Tip="{Binding Name}"
                            Background="{Binding Color, Converter={StaticResource AnnotationColorToBrush}}"
                            BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1"
                            CornerRadius="4" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <TextBlock Classes="sectionHeader" Text="עובי קו" IsVisible="{Binding SupportsLineWidth}" />
              <Slider Minimum="0.5" Maximum="16" TickFrequency="0.5" IsSnapToTickEnabled="True"
                      IsVisible="{Binding SupportsLineWidth}"
                      Value="{Binding LineWidth, Mode=TwoWay}"
                      AutomationProperties.Name="עובי קו" />

              <TextBlock Classes="sectionHeader" Text="שקיפות" />
              <Slider Minimum="0.1" Maximum="1.0" TickFrequency="0.05" IsSnapToTickEnabled="True"
                      Value="{Binding Opacity, Mode=TwoWay}"
                      AutomationProperties.Name="שקיפות" />

              <StackPanel Spacing="8" IsVisible="{Binding IsTextBox}">
                <TextBlock Classes="sectionHeader" Text="{x:Static loc:Strings.ToolTextBox}" />
                <TextBox AcceptsReturn="True" MinHeight="90" TextWrapping="Wrap"
                         Text="{Binding Text, Mode=TwoWay}"
                         AutomationProperties.Name="{x:Static loc:Strings.ToolTextBox}" />
                <TextBlock Classes="sectionHeader" Text="גודל גופן" />
                <Slider Minimum="8" Maximum="48" TickFrequency="1" IsSnapToTickEnabled="True"
                        Value="{Binding FontSize, Mode=TwoWay}"
                        AutomationProperties.Name="גודל גופן" />
              </StackPanel>

              <TextBlock Classes="muted" Text="{Binding GeometryText}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="8"
                        DataContext="{Binding $parent[Window].DataContext}"
                        x:DataType="vm:MainWindowViewModel">
              <Button Classes="secondary" Command="{Binding DuplicateSelectionCommand}"
                      Content="{x:Static loc:Strings.Duplicate}" />
              <Button Classes="secondary" Command="{Binding DeleteSelectionCommand}"
                      Content="{x:Static loc:Strings.Delete}" />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>

    <!-- Status bar -->
    <Border Grid.Row="3" Classes="bar" BorderThickness="0,1,0,0" Padding="12,6"
            AutomationProperties.Name="{x:Static loc:Strings.A11yStatusBar}">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto">
        <TextBlock Grid.Column="0" Text="{Binding Document.PageIndicatorText}"
                   IsVisible="{Binding HasDocument}" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Margin="16,0" VerticalAlignment="Center"
                   IsVisible="{Binding HasDocument}"
                   Text="{Binding Document.SaveStateText}" />

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" Margin="16,0"
                    IsVisible="{Binding IsBusy}">
          <TextBlock Text="{Binding BusyText}" VerticalAlignment="Center" />
          <ProgressBar Width="180" Minimum="0" Maximum="1" Value="{Binding Progress}"
                       VerticalAlignment="Center" />
          <Button Classes="command" Command="{Binding CancelCommand}"
                  Content="{x:Static loc:Strings.Cancel}" />
        </StackPanel>

        <TextBlock Grid.Column="3" VerticalAlignment="Center" MaxWidth="520"
                   IsVisible="{Binding HasStatusMessage}"
                   Classes.error="{Binding StatusIsError}"
                   Text="{Binding StatusMessage}" />

        <TextBlock Grid.Column="4" Margin="16,0,0,0" VerticalAlignment="Center" Classes="muted"
                   Text="{Binding ActiveToolLabel}" IsVisible="{Binding HasDocument}" />
      </Grid>
    </Border>
  </Grid>
</Window>
