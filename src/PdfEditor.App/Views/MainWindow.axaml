<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PdfEditor.App.ViewModels"
        xmlns:ctl="clr-namespace:PdfEditor.App.Controls"
        xmlns:loc="clr-namespace:PdfEditor.Core.Localization;assembly=PdfEditor.Core"
        x:Class="PdfEditor.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        FlowDirection="RightToLeft"
        Title="{Binding WindowTitle}"
        Width="1280" Height="820"
        MinWidth="680" MinHeight="520"
        Icon="avares://PdfEditor/Assets/app.ico"
        Background="{DynamicResource CanvasBrush}">

  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+O" Command="{Binding OpenCommand}" />
    <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+S" Command="{Binding SaveAsCommand}" />
    <KeyBinding Gesture="Ctrl+P" Command="{Binding PrintCommand}" />
    <KeyBinding Gesture="Ctrl+Z" Command="{Binding UndoCommand}" />
    <KeyBinding Gesture="Ctrl+Y" Command="{Binding RedoCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+Z" Command="{Binding RedoCommand}" />
    <KeyBinding Gesture="Ctrl+C" Command="{Binding CopySelectionCommand}" />
    <KeyBinding Gesture="Ctrl+V" Command="{Binding PasteCommand}" />
    <KeyBinding Gesture="Ctrl+D" Command="{Binding DuplicateSelectionCommand}" />
    <KeyBinding Gesture="Delete" Command="{Binding DeleteSelectionCommand}" />
    <KeyBinding Gesture="Escape" Command="{Binding ClearSelectionCommand}" />
    <KeyBinding Gesture="Ctrl+OemPlus" Command="{Binding ZoomInCommand}" />
    <KeyBinding Gesture="Ctrl+Add" Command="{Binding ZoomInCommand}" />
    <KeyBinding Gesture="Ctrl+OemMinus" Command="{Binding ZoomOutCommand}" />
    <KeyBinding Gesture="Ctrl+Subtract" Command="{Binding ZoomOutCommand}" />
    <KeyBinding Gesture="Ctrl+D0" Command="{Binding FitPageCommand}" />
    <KeyBinding Gesture="Ctrl+NumPad0" Command="{Binding FitPageCommand}" />
    <KeyBinding Gesture="Ctrl+B" Command="{Binding ToggleThumbnailsCommand}" />
    <KeyBinding Gesture="PageDown" Command="{Binding NextPageCommand}" />
    <KeyBinding Gesture="PageUp" Command="{Binding PreviousPageCommand}" />
  </Window.KeyBindings>

  <Window.Resources>

    <!-- The thumbnail rail and the properties panel are declared once and hosted twice: docked in
         the main row on a wide window, floating over the document on a narrow one. -->
    <DataTemplate x:Key="ThumbnailRail" x:DataType="vm:MainWindowViewModel">
      <DockPanel>
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="12,10,8,6">
          <TextBlock Grid.Column="0" Classes="sectionHeader" Margin="0"
                     VerticalAlignment="Center" Text="{x:Static loc:Strings.Thumbnails}" />
          <Button Grid.Column="1" Classes="command" Padding="6"
                  Command="{Binding ToggleThumbnailsCommand}"
                  IsVisible="{Binding PanelsFloat}"
                  ToolTip.Tip="{x:Static loc:Strings.Close}"
                  AutomationProperties.Name="{x:Static loc:Strings.Close}">
            <Path Data="{x:Static vm:Icons.Close}" Fill="{Binding $parent[Button].Foreground}" />
          </Button>
        </Grid>
        <ListBox Name="ThumbnailList" Classes="thumbs"
                 ItemsSource="{Binding Document.Pages}"
                 SelectedIndex="{Binding Document.CurrentPageIndex, Mode=TwoWay}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:PageViewModel">
              <StackPanel Spacing="5" Margin="2,5">
                <!-- Pinned left to right: the tile shows a document, and a right to left flow
                     direction would mirror everything drawn inside it. -->
                <Border Classes="thumb" Classes.current="{Binding IsSelected}"
                        FlowDirection="LeftToRight" HorizontalAlignment="Center"
                        Width="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ThumbnailTileWidth}">
                  <Image Source="{Binding Thumbnail}" Stretch="Uniform" Height="140" />
                </Border>
                <TextBlock Text="{Binding PageNumber}" HorizontalAlignment="Center" Classes="muted"
                           FontWeight="{Binding IsSelected, Converter={StaticResource BoolToWeight}}" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </DataTemplate>

    <DataTemplate x:Key="PropertiesPanel" x:DataType="vm:MainWindowViewModel">
      <ScrollViewer Padding="14">
        <StackPanel Spacing="14">

          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0" DataContext="{Binding Properties}" x:DataType="vm:PropertiesViewModel">
              <TextBlock Classes="title" Text="{Binding TitleText}" />
              <TextBlock Classes="muted" Text="{Binding PageText}" />
            </StackPanel>
            <Button Grid.Column="1" Classes="command" Padding="6" VerticalAlignment="Top"
                    Command="{Binding ClearSelectionCommand}"
                    ToolTip.Tip="{x:Static loc:Strings.Close}"
                    AutomationProperties.Name="{x:Static loc:Strings.Close}">
              <Path Data="{x:Static vm:Icons.Close}" Fill="{Binding $parent[Button].Foreground}" />
            </Button>
          </Grid>

          <StackPanel Spacing="14" DataContext="{Binding Properties}" x:DataType="vm:PropertiesViewModel">

            <Border Classes="group" IsVisible="{Binding IsForeign}">
              <TextBlock Classes="muted"
                         Text="הערה זו נוצרה בתוכנה אחרת ולכן אינה ניתנת לעריכה כאן. היא תישמר כפי שהיא." />
            </Border>

            <StackPanel Spacing="14" IsVisible="{Binding IsEditable}">

              <Border Classes="group">
                <StackPanel Spacing="4">
                  <TextBlock Classes="sectionHeader" Text="{x:Static loc:Strings.ColorLabel}" />
                  <ItemsControl ItemsSource="{x:Static vm:PropertiesViewModel.Swatches}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:ColorSwatch">
                        <Button Width="30" Height="30" Margin="0,0,7,7" Padding="0"
                                Click="OnSwatchClicked" Tag="{Binding}"
                                AutomationProperties.Name="{Binding Name}"
                                ToolTip.Tip="{Binding Name}"
                                Background="{Binding Color, Converter={StaticResource AnnotationColorToBrush}}"
                                BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1"
                                CornerRadius="15" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>

              <Border Classes="group" IsVisible="{Binding SupportsLineWidth}">
                <StackPanel Spacing="2">
                  <TextBlock Classes="sectionHeader" Text="{x:Static loc:Strings.LineWidthLabel}" />
                  <Slider Minimum="0.5" Maximum="16" TickFrequency="0.5" IsSnapToTickEnabled="True"
                          Value="{Binding LineWidth, Mode=TwoWay}"
                          AutomationProperties.Name="{x:Static loc:Strings.LineWidthLabel}" />
                </StackPanel>
              </Border>

              <Border Classes="group">
                <StackPanel Spacing="2">
                  <TextBlock Classes="sectionHeader" Text="{x:Static loc:Strings.OpacityLabel}" />
                  <Slider Minimum="0.1" Maximum="1.0" TickFrequency="0.05" IsSnapToTickEnabled="True"
                          Value="{Binding Opacity, Mode=TwoWay}"
                          AutomationProperties.Name="{x:Static loc:Strings.OpacityLabel}" />
                </StackPanel>
              </Border>

              <Border Classes="group" IsVisible="{Binding IsTextBox}">
                <StackPanel Spacing="6">
                  <TextBlock Classes="sectionHeader" Margin="0" Text="{x:Static loc:Strings.ToolTextBox}" />
                  <TextBox AcceptsReturn="True" MinHeight="88" TextWrapping="Wrap"
                           Text="{Binding Text, Mode=TwoWay}"
                           AutomationProperties.Name="{x:Static loc:Strings.ToolTextBox}" />

                  <Grid ColumnDefinitions="*,Auto" Margin="0,6,0,0">
                    <TextBlock Grid.Column="0" Classes="sectionHeader" Margin="0"
                               Text="{x:Static loc:Strings.FontSizeLabel}" />
                    <!-- The number matters: a form is usually matched to a size, not eyeballed. -->
                    <TextBlock Grid.Column="1" Classes="muted ltr" Margin="0"
                               Text="{Binding FontSizeText}" />
                  </Grid>
                  <Slider Minimum="8" Maximum="48" TickFrequency="1" IsSnapToTickEnabled="True"
                          Value="{Binding FontSize, Mode=TwoWay}"
                          AutomationProperties.Name="{x:Static loc:Strings.FontSizeLabel}" />

                  <CheckBox IsChecked="{Binding Bold, Mode=TwoWay}"
                            Content="{x:Static loc:Strings.BoldLabel}"
                            AutomationProperties.Name="{x:Static loc:Strings.BoldLabel}" />

                  <TextBlock Classes="sectionHeader" Margin="0,2,0,0"
                             Text="{x:Static loc:Strings.AlignmentLabel}" />
                  <!-- Named by where the line starts rather than by a side, because the annotation
                       follows its own text direction: start is the right in Hebrew and the left in
                       a Latin run. -->
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <RadioButton Classes="segment" GroupName="align" Click="OnAlignmentChosen" Tag="Start"
                                 IsChecked="{Binding IsAlignStart, Mode=OneWay}"
                                 Content="{x:Static loc:Strings.AlignStart}"
                                 ToolTip.Tip="{x:Static loc:Strings.AlignStartHint}"
                                 AutomationProperties.Name="{x:Static loc:Strings.AlignStartHint}" />
                    <RadioButton Classes="segment" GroupName="align" Click="OnAlignmentChosen" Tag="Center"
                                 IsChecked="{Binding IsAlignCenter, Mode=OneWay}"
                                 Content="{x:Static loc:Strings.AlignCenter}"
                                 ToolTip.Tip="{x:Static loc:Strings.AlignCenterHint}"
                                 AutomationProperties.Name="{x:Static loc:Strings.AlignCenterHint}" />
                    <RadioButton Classes="segment" GroupName="align" Click="OnAlignmentChosen" Tag="End"
                                 IsChecked="{Binding IsAlignEnd, Mode=OneWay}"
                                 Content="{x:Static loc:Strings.AlignEnd}"
                                 ToolTip.Tip="{x:Static loc:Strings.AlignEndHint}"
                                 AutomationProperties.Name="{x:Static loc:Strings.AlignEndHint}" />
                  </StackPanel>
                </StackPanel>
              </Border>

              <!-- Pinned left to right: "×" is a neutral character, so in a Hebrew paragraph the
                   width and the height would swap places on screen. -->
              <TextBlock Classes="muted ltr" HorizontalAlignment="Left" Text="{Binding GeometryText}" />
            </StackPanel>
          </StackPanel>

          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Stretch">
            <Button Classes="secondary" Command="{Binding DuplicateSelectionCommand}"
                    Content="{x:Static loc:Strings.Duplicate}" />
            <Button Classes="secondary danger" Command="{Binding DeleteSelectionCommand}"
                    Content="{x:Static loc:Strings.Delete}" />
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </DataTemplate>
  </Window.Resources>

  <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">

    <!-- Command bar -->
    <Border Grid.Row="0" Classes="bar" BorderThickness="0,0,0,1" Padding="10,7"
            BoxShadow="{DynamicResource BarShadow}">
      <Grid ColumnDefinitions="Auto,*,Auto">

        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="2">
          <Button Classes="command" Command="{Binding ToggleThumbnailsCommand}"
                  IsVisible="{Binding HasDocument}"
                  ToolTip.Tip="{x:Static loc:Strings.Thumbnails}"
                  AutomationProperties.Name="{x:Static loc:Strings.Thumbnails}">
            <Path Data="{x:Static vm:Icons.Sidebar}" Fill="{Binding $parent[Button].Foreground}" />
          </Button>

          <Border Classes="divider" IsVisible="{Binding HasDocument}" />

          <Button Classes="command accent" Command="{Binding OpenCommand}"
                  ToolTip.Tip="Ctrl+O"
                  AutomationProperties.Name="{x:Static loc:Strings.Open}">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <Path Data="{x:Static vm:Icons.Open}" Fill="{Binding $parent[Button].Foreground}" />
              <TextBlock Text="{x:Static loc:Strings.Open}" VerticalAlignment="Center"
                         IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ShowCommandLabels}" />
            </StackPanel>
          </Button>

          <!-- Everything that needs a document leaves the bar entirely when there is none, so the
               empty state is an invitation rather than a wall of dead buttons. -->
          <StackPanel Orientation="Horizontal" Spacing="2" IsVisible="{Binding HasDocument}">
            <Border Classes="divider" />

            <Button Classes="command" Command="{Binding SaveCommand}"
                  ToolTip.Tip="Ctrl+S" AutomationProperties.Name="{x:Static loc:Strings.Save}">
            <Path Data="{x:Static vm:Icons.Save}" Fill="{Binding $parent[Button].Foreground}" />
          </Button>
          <Button Classes="command" Command="{Binding SaveAsCommand}"
                  ToolTip.Tip="{x:Static loc:Strings.SaveAs}"
                  AutomationProperties.Name="{x:Static loc:Strings.SaveAs}">
            <Path Data="{x:Static vm:Icons.SaveAs}" Fill="{Binding $parent[Button].Foreground}" />
          </Button>
          <!-- Export and print step aside at the narrowest width along with the document
               operations. Both keep their shortcuts and both are in the overflow menu, so nothing
               becomes unreachable — but at 680 the bar cannot hold them without clipping. -->
          <Button Classes="command" Command="{Binding ExportCommand}"
                  IsVisible="{Binding ShowDocumentOpsInline}"
                  ToolTip.Tip="{x:Static loc:Strings.ExportFinalCopy}"
                  AutomationProperties.Name="{x:Static loc:Strings.ExportFinalCopy}">
            <Path Data="{x:Static vm:Icons.Export}" Fill="{Binding $parent[Button].Foreground}" />
          </Button>
          <Button Classes="command" Command="{Binding PrintCommand}"
                  IsVisible="{Binding ShowDocumentOpsInline}"
                  ToolTip.Tip="Ctrl+P" AutomationProperties.Name="{x:Static loc:Strings.Print}">
            <Path Data="{x:Static vm:Icons.Print}" Fill="{Binding $parent[Button].Foreground}" />
          </Button>

          <Border Classes="divider" />

          <Button Classes="command" Command="{Binding UndoCommand}"
                  ToolTip.Tip="Ctrl+Z" AutomationProperties.Name="{x:Static loc:Strings.Undo}">
            <Path Data="{x:Static vm:Icons.Undo}" Fill="{Binding $parent[Button].Foreground}" />
          </Button>
          <Button Classes="command" Command="{Binding RedoCommand}"
                  ToolTip.Tip="Ctrl+Y" AutomationProperties.Name="{x:Static loc:Strings.Redo}">
            <Path Data="{x:Static vm:Icons.Redo}" Fill="{Binding $parent[Button].Foreground}" />
          </Button>

          <Border Classes="divider" IsVisible="{Binding ShowDocumentOpsInline}" />

          <!-- Document operations stay in the bar while there is room, and move into the overflow
               menu when the window is too narrow to show them without clipping. -->
          <StackPanel Orientation="Horizontal" Spacing="2" IsVisible="{Binding ShowDocumentOpsInline}">
            <Button Classes="command" Command="{Binding MergeCommand}"
                    ToolTip.Tip="{x:Static loc:Strings.Merge}"
                    AutomationProperties.Name="{x:Static loc:Strings.Merge}">
              <Path Data="{x:Static vm:Icons.Merge}" Fill="{Binding $parent[Button].Foreground}" />
            </Button>
            <Button Classes="command" Command="{Binding SplitCommand}"
                    ToolTip.Tip="{x:Static loc:Strings.Split}"
                    AutomationProperties.Name="{x:Static loc:Strings.Split}">
              <Path Data="{x:Static vm:Icons.Split}" Fill="{Binding $parent[Button].Foreground}" />
            </Button>
            <Button Classes="command" Command="{Binding ShowPageOperationsCommand}"
                    ToolTip.Tip="{x:Static loc:Strings.PageOperations}"
                    AutomationProperties.Name="{x:Static loc:Strings.PageOperations}">
              <Path Data="{x:Static vm:Icons.Pages}" Fill="{Binding $parent[Button].Foreground}" />
            </Button>
            <Button Classes="command" Command="{Binding RunOcrCommand}"
                    ToolTip.Tip="{x:Static loc:Strings.OcrRunOnPage}"
                    AutomationProperties.Name="{x:Static loc:Strings.Ocr}">
              <Path Data="{x:Static vm:Icons.Ocr}" Fill="{Binding $parent[Button].Foreground}" />
            </Button>
          </StackPanel>

          <Button Classes="command" IsVisible="{Binding ShowOverflowMenu}"
                  ToolTip.Tip="{x:Static loc:Strings.MoreActions}"
                  AutomationProperties.Name="{x:Static loc:Strings.MoreActions}">
            <Path Data="{x:Static vm:Icons.More}" Fill="{Binding $parent[Button].Foreground}" />
            <Button.Flyout>
              <MenuFlyout>
                <MenuItem Header="{x:Static loc:Strings.Print}" Command="{Binding PrintCommand}" />
                <MenuItem Header="{x:Static loc:Strings.ExportFinalCopy}" Command="{Binding ExportCommand}" />
                <Separator />
                <MenuItem Header="{x:Static loc:Strings.Merge}" Command="{Binding MergeCommand}" />
                <MenuItem Header="{x:Static loc:Strings.Split}" Command="{Binding SplitCommand}" />
                <MenuItem Header="{x:Static loc:Strings.PageOperations}" Command="{Binding ShowPageOperationsCommand}" />
                <MenuItem Header="{x:Static loc:Strings.OcrRunOnPage}" Command="{Binding RunOcrCommand}" />
                <Separator />
                <MenuItem Header="{x:Static loc:Strings.ClearOcrCache}" Command="{Binding ClearOcrCacheCommand}" />
              </MenuFlyout>
            </Button.Flyout>
            </Button>
          </StackPanel>
        </StackPanel>

        <Border Grid.Column="1" Classes="searchField" MaxWidth="380" Margin="18,0"
                IsVisible="{Binding ShowSearchInCommandBar}">
          <Grid ColumnDefinitions="Auto,*">
            <Path Grid.Column="0" Data="{x:Static vm:Icons.Search}" VerticalAlignment="Center"
                  Fill="{DynamicResource TextMutedBrush}" />
            <TextBox Grid.Column="1" Name="SearchBox" VerticalAlignment="Center"
                     Watermark="{x:Static loc:Strings.Search}"
                     Text="{Binding SearchText, Mode=TwoWay}"
                     AutomationProperties.Name="{x:Static loc:Strings.Search}" />
          </Grid>
        </Border>

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2">
          <StackPanel Orientation="Horizontal" Spacing="2" IsVisible="{Binding HasDocument}">
          <Button Classes="command" Command="{Binding ZoomOutCommand}"
                  AutomationProperties.Name="{x:Static loc:Strings.ZoomOut}"
                  ToolTip.Tip="Ctrl+-">
            <Path Data="{x:Static vm:Icons.ZoomOut}" Fill="{Binding $parent[Button].Foreground}" />
          </Button>
          <TextBlock Text="{Binding Document.ZoomPercentText}" VerticalAlignment="Center"
                     MinWidth="50" TextAlignment="Center" Classes="ltr" />
          <Button Classes="command" Command="{Binding ZoomInCommand}"
                  AutomationProperties.Name="{x:Static loc:Strings.ZoomIn}"
                  ToolTip.Tip="Ctrl++">
            <Path Data="{x:Static vm:Icons.ZoomIn}" Fill="{Binding $parent[Button].Foreground}" />
          </Button>
          <Button Classes="command" Command="{Binding FitWidthCommand}"
                  AutomationProperties.Name="{x:Static loc:Strings.FitWidth}"
                  ToolTip.Tip="{x:Static loc:Strings.FitWidth}">
            <Path Data="{x:Static vm:Icons.FitWidth}" Fill="{Binding $parent[Button].Foreground}" />
          </Button>
          <Button Classes="command" Command="{Binding FitPageCommand}"
                  AutomationProperties.Name="{x:Static loc:Strings.FitPage}"
                  ToolTip.Tip="Ctrl+0">
            <Path Data="{x:Static vm:Icons.FitPage}" Fill="{Binding $parent[Button].Foreground}" />
          </Button>

          <Border Classes="divider" />
          </StackPanel>

          <Button Classes="command" Command="{Binding ToggleThemeCommand}"
                  AutomationProperties.Name="{x:Static loc:Strings.ThemeLabel}"
                  ToolTip.Tip="{Binding ThemeLabel}">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <Path Data="{x:Static vm:Icons.Theme}" Fill="{Binding $parent[Button].Foreground}" />
              <TextBlock Text="{Binding ThemeLabel}" VerticalAlignment="Center"
                         IsVisible="{Binding ShowCommandLabels}" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Compact windows give the search field a row of its own rather than squeezing it out. -->
    <Border Grid.Row="1" Classes="bar" BorderThickness="0,0,0,1" Padding="10,0,10,8"
            IsVisible="{Binding ShowSearchRow}">
      <Border Classes="searchField">
        <Grid ColumnDefinitions="Auto,*">
          <Path Grid.Column="0" Data="{x:Static vm:Icons.Search}" VerticalAlignment="Center"
                Fill="{DynamicResource TextMutedBrush}" />
          <TextBox Grid.Column="1" Name="CompactSearchBox" VerticalAlignment="Center"
                   Watermark="{x:Static loc:Strings.Search}"
                   Text="{Binding SearchText, Mode=TwoWay}"
                   AutomationProperties.Name="{x:Static loc:Strings.Search}" />
        </Grid>
      </Border>
    </Border>

    <!-- Tool strip: one rounded group, centred, so the drawing tools read as a single instrument -->
    <Border Grid.Row="2" Classes="bar" BorderThickness="0,0,0,1" Padding="10,7"
            IsVisible="{Binding HasDocument}"
            AutomationProperties.Name="{x:Static loc:Strings.A11yToolbar}">
      <Border Classes="toolstrip" HorizontalAlignment="Center">
        <ItemsControl ItemsSource="{Binding Toolbox.Tools}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" Spacing="2" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ToolItemViewModel">
              <ToggleButton Classes="tool"
                            IsChecked="{Binding IsSelected, Mode=OneWay}"
                            Click="OnToolClicked"
                            Tag="{Binding Tool}"
                            ToolTip.Tip="{Binding AccessibleName}"
                            AutomationProperties.Name="{Binding AccessibleName}">
                <Path Data="{Binding Glyph}" Fill="{Binding $parent[ToggleButton].Foreground}" />
              </ToggleButton>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Border>
    </Border>

    <!-- Main area: thumbnails on the right (the leading side under RTL), properties on the left -->
    <Grid Grid.Row="3" Name="MainGrid" ColumnDefinitions="200,Auto,*,Auto,268">

      <Border Grid.Column="0" Name="ThumbnailsPanel" Classes="bar" BorderThickness="0,0,1,0"
              IsVisible="{Binding IsThumbnailRailVisible}"
              AutomationProperties.Name="{x:Static loc:Strings.A11yThumbnailList}">
        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ThumbnailRail}" />
      </Border>

      <GridSplitter Grid.Column="1" ResizeDirection="Columns"
                    IsVisible="{Binding IsThumbnailRailVisible}" />

      <!-- Document canvas -->
      <Panel Grid.Column="2" Name="DocumentArea" Classes="board">
        <ScrollViewer Name="DocumentScroll" Padding="{Binding CanvasPadding}"
                      HorizontalScrollBarVisibility="Auto"
                      AutomationProperties.Name="{x:Static loc:Strings.A11yPageCanvas}"
                      IsVisible="{Binding HasDocument}">
          <ItemsControl ItemsSource="{Binding Document.Pages}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <VirtualizingStackPanel Orientation="Vertical" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:PageViewModel">
                <!-- The page is a document, not part of the interface: a right-to-left flow
                     direction would mirror its content, so the canvas is pinned left-to-right. -->
                <Border Classes="page" HorizontalAlignment="Center" FlowDirection="LeftToRight"
                        Width="{Binding DisplayWidth}" Height="{Binding DisplayHeight}">
                  <ctl:PageSurface Page="{Binding}"
                                   FlowDirection="LeftToRight"
                                   SignatureRequested="OnSignatureRequested"
                                   Document="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Document}"
                                   ActiveTool="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Toolbox.ActiveTool}" />
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

        <!-- Empty state -->
        <ScrollViewer IsVisible="{Binding IsEmpty}" Padding="24">
          <Border Classes="card" MaxWidth="520" VerticalAlignment="Center" HorizontalAlignment="Center">
            <StackPanel Spacing="14">
              <Image Source="avares://PdfEditor/Assets/app-256.png" Width="88" Height="88"
                     HorizontalAlignment="Center" />
              <TextBlock Classes="display" Text="{x:Static loc:Strings.AppName}"
                         HorizontalAlignment="Center" TextAlignment="Center" />
              <TextBlock Classes="muted" Text="{x:Static loc:Strings.AppTagline}"
                         HorizontalAlignment="Center" TextAlignment="Center" />
              <TextBlock Text="{x:Static loc:Strings.EmptyStateBody}" TextAlignment="Center"
                         HorizontalAlignment="Center" Margin="0,4,0,0" />
              <Button Classes="primary" Command="{Binding OpenCommand}"
                      Content="{x:Static loc:Strings.OpenFile}" HorizontalAlignment="Center" />

              <Border Classes="group" Margin="0,6,0,0">
                <StackPanel Spacing="6">
                  <TextBlock Classes="sectionHeader" Margin="0" Text="{x:Static loc:Strings.ShortcutsTitle}" />
                  <TextBlock Classes="muted ltr" HorizontalAlignment="Left"
                             Text="Ctrl+O · Ctrl+S · Ctrl+P · Ctrl+Z · Ctrl+F · Ctrl+0" />
                </StackPanel>
              </Border>

              <TextBlock Classes="muted" Text="{x:Static loc:Strings.PrivacyBody}"
                         TextAlignment="Center" />
            </StackPanel>
          </Border>
        </ScrollViewer>

        <!-- Search results. Search runs over recognised text, so the card also explains an empty
             result rather than leaving the user guessing. -->
        <Border Classes="card" IsVisible="{Binding ShowSearchResults}"
                VerticalAlignment="Top" HorizontalAlignment="Center"
                Margin="0,14,0,0" Width="380" MaxHeight="320" Padding="14"
                AutomationProperties.Name="{x:Static loc:Strings.SearchResults}">
          <DockPanel>
            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
              <StackPanel Grid.Column="0">
                <TextBlock Classes="sectionHeader" Margin="0" Text="{x:Static loc:Strings.SearchResults}" />
                <TextBlock Classes="muted" Text="{Binding SearchSummaryText}" />
              </StackPanel>
              <Button Grid.Column="1" Classes="command" Padding="6" VerticalAlignment="Top"
                      Command="{Binding ClearSearchCommand}"
                      ToolTip.Tip="{x:Static loc:Strings.Close}"
                      AutomationProperties.Name="{x:Static loc:Strings.Close}">
                <Path Data="{x:Static vm:Icons.Close}" Fill="{Binding $parent[Button].Foreground}" />
              </Button>
            </Grid>
            <ItemsControl ItemsSource="{Binding SearchResults}" IsVisible="{Binding HasSearchResults}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:SearchHitViewModel">
                  <Button Classes="command" HorizontalAlignment="Stretch" Margin="0,0,0,4"
                          HorizontalContentAlignment="Stretch"
                          Click="OnSearchHitClicked" Tag="{Binding}"
                          AutomationProperties.Name="{Binding PageLabel}">
                    <StackPanel>
                      <TextBlock Classes="muted" Text="{Binding PageLabel}" />
                      <TextBlock Text="{Binding Snippet}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </DockPanel>
        </Border>

        <!-- Compact windows float the panels over the document instead of shrinking it away. -->
        <Border Classes="bar" HorizontalAlignment="Left" BorderThickness="0,0,1,0"
                Width="{Binding ThumbnailRailWidth}"
                BoxShadow="{DynamicResource CardShadow}"
                IsVisible="{Binding IsThumbnailOverlayVisible}"
                AutomationProperties.Name="{x:Static loc:Strings.A11yThumbnailList}">
          <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ThumbnailRail}" />
        </Border>

        <Border Classes="bar" HorizontalAlignment="Right" BorderThickness="1,0,0,0"
                Width="{Binding PropertiesPanelWidth}"
                BoxShadow="{DynamicResource CardShadow}"
                IsVisible="{Binding IsPropertiesFloating}"
                AutomationProperties.Name="{x:Static loc:Strings.A11yPropertiesPanel}">
          <ContentControl Content="{Binding}" ContentTemplate="{StaticResource PropertiesPanel}" />
        </Border>
      </Panel>

      <GridSplitter Grid.Column="3" ResizeDirection="Columns"
                    IsVisible="{Binding IsPropertiesDocked}" />

      <Border Grid.Column="4" Name="PropertiesPanel" Classes="bar" BorderThickness="1,0,0,0"
              IsVisible="{Binding IsPropertiesDocked}"
              AutomationProperties.Name="{x:Static loc:Strings.A11yPropertiesPanel}">
        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource PropertiesPanel}" />
      </Border>
    </Grid>

    <!-- Status bar -->
    <Border Grid.Row="4" Classes="bar" BorderThickness="0,1,0,0" Padding="12,6"
            AutomationProperties.Name="{x:Static loc:Strings.A11yStatusBar}">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto">
        <Border Grid.Column="0" Classes="pill" IsVisible="{Binding HasDocument}">
          <TextBlock Text="{Binding Document.PageIndicatorText}" VerticalAlignment="Center" />
        </Border>

        <Border Grid.Column="1" Classes="pill" Margin="8,0"
                Classes.dirty="{Binding Document.IsDirty, FallbackValue=False}"
                IsVisible="{Binding HasDocument}">
          <TextBlock Text="{Binding Document.SaveStateText}" VerticalAlignment="Center" />
        </Border>

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" Margin="16,0"
                    IsVisible="{Binding IsBusy}">
          <TextBlock Text="{Binding BusyText}" VerticalAlignment="Center" />
          <ProgressBar Width="180" Minimum="0" Maximum="1" Value="{Binding Progress}"
                       VerticalAlignment="Center" />
          <Button Classes="command" Command="{Binding CancelCommand}"
                  Content="{x:Static loc:Strings.Cancel}" />
        </StackPanel>

        <TextBlock Grid.Column="3" VerticalAlignment="Center" MaxWidth="520"
                   IsVisible="{Binding HasStatusMessage}"
                   Classes.error="{Binding StatusIsError}"
                   Text="{Binding StatusMessage}" />

        <TextBlock Grid.Column="4" Margin="16,0,0,0" VerticalAlignment="Center" Classes="muted"
                   Text="{Binding ActiveToolLabel}" IsVisible="{Binding HasDocument}" />
      </Grid>
    </Border>

    <!-- Page operations. Rotating, deleting and extracting always write a new file, so this dialog
         can never damage what is open behind it. -->
    <Border Grid.Row="0" Grid.RowSpan="5" Background="{DynamicResource ScrimBrush}"
            IsVisible="{Binding IsPageOperationsOpen}">
      <Border Classes="card" MaxWidth="520" Margin="24"
              VerticalAlignment="Center" HorizontalAlignment="Center"
              DataContext="{Binding PageOperations}" x:DataType="vm:PageOperationsViewModel">
        <StackPanel Spacing="14">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" Classes="title" Text="{x:Static loc:Strings.PageOperations}" />
            <Button Grid.Column="1" Classes="command" Padding="6"
                    Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ClosePageOperationsCommand}"
                    ToolTip.Tip="{x:Static loc:Strings.Close}"
                    AutomationProperties.Name="{x:Static loc:Strings.Close}">
              <Path Data="{x:Static vm:Icons.Close}" Fill="{Binding $parent[Button].Foreground}" />
            </Button>
          </Grid>

          <Border Classes="group">
            <StackPanel Spacing="6">
              <TextBlock Classes="sectionHeader" Margin="0" Text="{x:Static loc:Strings.PageRangeLabel}" />
              <TextBox Text="{Binding RangeText, Mode=TwoWay}" Watermark="1-3,5,8-10"
                       AutomationProperties.Name="{x:Static loc:Strings.PageRangeLabel}" />
              <TextBlock Classes="error" IsVisible="{Binding HasRangeError}" Text="{Binding RangeError}" />
            </StackPanel>
          </Border>

          <Border Classes="group">
            <StackPanel Spacing="4">
              <TextBlock Classes="sectionHeader" Margin="0" Text="{x:Static loc:Strings.PageOperations}" />
              <RadioButton GroupName="PageOperation" IsChecked="{Binding IsRotateRight, Mode=OneWay}"
                           Click="OnPageOperationChosen" Tag="RotateRight"
                           Content="{x:Static loc:Strings.RotateRight}" />
              <RadioButton GroupName="PageOperation" IsChecked="{Binding IsRotateLeft, Mode=OneWay}"
                           Click="OnPageOperationChosen" Tag="RotateLeft"
                           Content="{x:Static loc:Strings.RotateLeft}" />
              <RadioButton GroupName="PageOperation" IsChecked="{Binding IsDelete, Mode=OneWay}"
                           Click="OnPageOperationChosen" Tag="Delete"
                           Content="{x:Static loc:Strings.DeletePages}" />
              <RadioButton GroupName="PageOperation" IsChecked="{Binding IsExtract, Mode=OneWay}"
                           Click="OnPageOperationChosen" Tag="Extract"
                           Content="{x:Static loc:Strings.ExtractPages}" />
            </StackPanel>
          </Border>

          <TextBlock Text="{Binding SummaryText}" />
          <TextBlock Classes="muted" Text="{x:Static loc:Strings.PageOperationOutputIsNew}" />

          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left">
            <Button Classes="primary"
                    Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ApplyPageOperationCommand}"
                    Content="{x:Static loc:Strings.Apply}" />
            <Button Classes="secondary"
                    Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ClosePageOperationsCommand}"
                    Content="{x:Static loc:Strings.Cancel}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>

    <!-- The signature library. Filling a form usually ends in signing it, so this is reached by
         placing the signature tool rather than from settings. Nothing is added to the page until a
         signature is chosen, so cancelling leaves the document untouched. -->
    <Border Grid.Row="0" Grid.RowSpan="5" Background="{DynamicResource ScrimBrush}"
            IsVisible="{Binding IsSignaturePickerOpen}">
      <Border Classes="card" MaxWidth="560" MaxHeight="620" Margin="24"
              VerticalAlignment="Center" HorizontalAlignment="Center"
              DataContext="{Binding SignaturePicker}" x:DataType="vm:SignaturePickerViewModel">
        <DockPanel>
          <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
            <TextBlock Grid.Column="0" Classes="title" Text="{x:Static loc:Strings.SignatureLibrary}" />
            <Button Grid.Column="1" Classes="command" Padding="6"
                    Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).CancelSignatureCommand}"
                    ToolTip.Tip="{x:Static loc:Strings.Close}"
                    AutomationProperties.Name="{x:Static loc:Strings.Close}">
              <Path Data="{x:Static vm:Icons.Close}" Fill="{Binding $parent[Button].Foreground}" />
            </Button>
          </Grid>

          <StackPanel DockPanel.Dock="Bottom" Spacing="10" Margin="0,14,0,0">
            <TextBlock Classes="muted" TextWrapping="Wrap"
                       Text="{x:Static loc:Strings.SignatureDisclaimer}" />
            <TextBlock Classes="muted" TextWrapping="Wrap"
                       Text="{x:Static loc:Strings.SignatureStorageNotice}" />
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left">
              <Button Classes="primary"
                      Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ConfirmSignatureCommand}"
                      Content="{x:Static loc:Strings.UseSignature}" />
              <Button Classes="secondary"
                      Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).CancelSignatureCommand}"
                      Content="{x:Static loc:Strings.Cancel}" />
            </StackPanel>
          </StackPanel>

          <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Classes="secondary" Command="{Binding ImportCommand}"
                      Content="{x:Static loc:Strings.ImportSignature}" />
              <Button Classes="secondary danger" Command="{Binding DeleteCommand}"
                      Content="{x:Static loc:Strings.Delete}" />
            </StackPanel>
            <CheckBox IsChecked="{Binding RemoveWhiteBackground, Mode=TwoWay}"
                      Content="{x:Static loc:Strings.RemoveWhiteBackground}"
                      ToolTip.Tip="{x:Static loc:Strings.RemoveWhiteBackground}" />
            <TextBlock Classes="error" IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}"
                       TextWrapping="Wrap" Text="{Binding Error}" />
          </StackPanel>

          <TextBlock IsVisible="{Binding IsEmpty}" Classes="muted" TextWrapping="Wrap"
                     VerticalAlignment="Center" TextAlignment="Center"
                     Text="{x:Static loc:Strings.NoSignaturesYet}" />

          <ScrollViewer IsVisible="{Binding !IsEmpty}" HorizontalScrollBarVisibility="Disabled">
            <ListBox Classes="signatures" ItemsSource="{Binding Signatures}"
                     SelectedItem="{Binding Selected, Mode=TwoWay}"
                     Background="Transparent" BorderThickness="0"
                     AutomationProperties.Name="{x:Static loc:Strings.Signatures}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:SignatureItemViewModel">
                  <Grid ColumnDefinitions="Auto,*" Height="64">
                    <!-- The preview is a document image: pinned left to right so a right to left
                         flow does not mirror it. -->
                    <Border Grid.Column="0" Classes="signaturePreview" Width="150" Margin="0,0,12,0"
                            FlowDirection="LeftToRight">
                      <Image Source="{Binding Preview}" Stretch="Uniform" Margin="6" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                      <TextBlock Text="{Binding DisplayName}" />
                      <TextBlock Classes="muted ltr" HorizontalAlignment="Right"
                                 Text="{Binding CreatedText}" />
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Border>

    <!-- Print dialog. Modal within the window, so nothing about the document changes behind it. -->
    <Border Grid.Row="0" Grid.RowSpan="5" Background="{DynamicResource ScrimBrush}"
            IsVisible="{Binding IsPrintPreviewOpen}">
      <Border Classes="card" MaxWidth="720" MaxHeight="640" Margin="24"
              VerticalAlignment="Center" HorizontalAlignment="Center"
              DataContext="{Binding PrintPreview}" x:DataType="vm:PrintPreviewViewModel">
        <DockPanel>
          <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
            <TextBlock Grid.Column="0" Classes="title" Text="{x:Static loc:Strings.PrintPreview}" />
            <Button Grid.Column="1" Classes="command" Padding="6"
                    Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ClosePrintPreviewCommand}"
                    ToolTip.Tip="{x:Static loc:Strings.Close}"
                    AutomationProperties.Name="{x:Static loc:Strings.Close}">
              <Path Data="{x:Static vm:Icons.Close}" Fill="{Binding $parent[Button].Foreground}" />
            </Button>
          </Grid>

          <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8"
                      HorizontalAlignment="Left" Margin="0,14,0,0">
            <Button Classes="primary"
                    Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ConfirmPrintCommand}"
                    Content="{x:Static loc:Strings.Print}" />
            <Button Classes="secondary"
                    Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ClosePrintPreviewCommand}"
                    Content="{x:Static loc:Strings.Cancel}" />
          </StackPanel>

          <ScrollViewer>
            <StackPanel Spacing="12">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <StackPanel Grid.Column="0" Spacing="4">
                  <TextBlock Classes="sectionHeader" Margin="0" Text="{x:Static loc:Strings.Printer}" />
                  <ComboBox ItemsSource="{Binding Printers}" SelectedItem="{Binding SelectedPrinter}"
                            HorizontalAlignment="Stretch"
                            AutomationProperties.Name="{x:Static loc:Strings.Printer}">
                    <ComboBox.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding Name}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="4" Width="180">
                  <TextBlock Classes="sectionHeader" Margin="0" Text="{x:Static loc:Strings.PrintRange}" />
                  <TextBox Text="{Binding RangeText, Mode=TwoWay}" Watermark="1-3,5"
                           AutomationProperties.Name="{x:Static loc:Strings.PrintRange}" />
                </StackPanel>
              </Grid>

              <TextBlock Classes="error" IsVisible="{Binding HasRangeError}" Text="{Binding RangeError}" />

              <Border Classes="group">
                <StackPanel Spacing="6">
                  <CheckBox IsChecked="{Binding SeparateSheetsPerContentPage, Mode=TwoWay}"
                            Content="{x:Static loc:Strings.SeparateSheets}" />
                  <TextBlock Classes="muted" Text="{x:Static vm:PrintPreviewViewModel.OptionHint}" />
                  <CheckBox IsChecked="{Binding AssumeDuplex, Mode=TwoWay}"
                            Content="{x:Static loc:Strings.AssumeDuplex}" />
                  <TextBlock Classes="muted" Text="{x:Static vm:PrintPreviewViewModel.LimitationText}" />
                </StackPanel>
              </Border>

              <TextBlock Text="{Binding SummaryText}" />

              <ItemsControl ItemsSource="{Binding Slots}" MaxHeight="220">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:PrintSlotViewModel">
                    <Border Classes="sheet" Classes.blank="{Binding !IsContent}"
                            Width="52" Height="70" Margin="0,0,8,8"
                            ToolTip.Tip="{Binding Caption}"
                            AutomationProperties.Name="{Binding Caption}">
                      <TextBlock Text="{Binding Label}" HorizontalAlignment="Center"
                                 VerticalAlignment="Center" Classes="muted" TextAlignment="Center" />
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Border>
  </Grid>
</Window>
